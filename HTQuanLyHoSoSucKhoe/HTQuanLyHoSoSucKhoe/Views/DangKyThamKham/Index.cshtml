@model List<HTQuanLyHoSoSucKhoe.ViewModels.AppointmentViewModel>


<div id="page-wrapper">
    <div class="header">
        <h1 class="page-header">
            Quản lý lịch sử thăm khám
        </h1>
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="DangKyThamKham">Trang chủ</a></li>
            <li class="active">Thông tin lịch sử thăm khám</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Hiển thị bảng lịch sử thăm khám -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng thông tin lịch sử thăm khám:
                        <button class="btn btn-success" data-toggle="modal" data-target="#myModal">
                            Đăng ký thăm khám
                        </button>
                        <!-- Modal -->
                        <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                        <h4 class="modal-title" id="myModalLabel">Tạo thông tin hồ sơ</h4>
                                    </div>
                                    <form asp-action="taoPhieuDangKyThamKham" asp-controller="DangKyThamKham" method="post">
                                        <div class="modal-body">
                                            <!-- Tên, Email, Số điện thoại, CCCD -->
                                            <div class="form-group">
                                                <label for="hoTen">Họ và Tên:</label>
                                                <input type="text" id="hoTen" name="hoTen" class="form-control" value="@ViewBag.UserInfo?.Name" />
                                            </div>

                                            <div class="form-group">
                                                <label for="email">Email:</label>
                                                <input type="email" id="email" name="email" class="form-control" value="@ViewBag.UserInfo?.Email" />
                                            </div>

                                            <div class="form-group">
                                                <label for="soDienThoai">Số điện thoại:</label>
                                                <input type="text" id="soDienThoai" name="soDienThoai" class="form-control" value="@ViewBag.UserInfo?.PhoneNumber" />
                                            </div>

                                            <div class="form-group">
                                                <label for="cccd">CCCD:</label>
                                                <input type="text" id="cccd" name="cccd" class="form-control" value="@ViewBag.UserInfo?.CCCD" />
                                            </div>

                                            <div class="form-group">
                                                <label for="BenhVienId">Bệnh viện:</label>
                                                <select id="BenhVienId" name="BenhVienId" class="form-control" required>
                                                    @foreach (var benhVien in ViewBag.BenhVienList ?? new List<BenhVien>())
                                                    {
                                                        <option value="@benhVien.Id">@benhVien.Name</option>
                                                    }
                                                </select>
                                            </div>

                                            <!-- Chọn loại dịch vụ thăm khám -->
                                            <div class="form-group">
                                                <label for="LoaiDichVuId">Loại dịch vụ thăm khám:</label>
                                                <select id="LoaiDichVuId" name="LoaiDichVuId" class="form-control" onchange="loadChuyenKhoa()" required>
                                                    @foreach (var dichVu in ViewBag.LoaiDichVuList ?? new List<LoaiDichVuKham>())
                                                    {
                                                        <option value="@dichVu.Id">@dichVu.TenDichVu</option>
                                                    }
                                                </select>
                                            </div>

                                            <!-- Chuyên khoa (Sẽ chỉ xuất hiện khi chọn "Khám chuyên khoa") -->
                                            <div class="form-group" id="chuyenKhoaDiv" style="display:none;">
                                                <label for="ChuyenKhoaId">Chọn chuyên khoa cần khám:</label>
                                                <select id="ChuyenKhoaId" name="ChuyenKhoaId" class="form-control">
                                                    <option value="">Chọn chuyên khoa</option>
                                                    @foreach (var chuyenKhoa in ViewBag.ChuyenKhoaList ?? new List<ChuyenKhoa>())
                                                    {
                                                        <option value="@chuyenKhoa.Id">@chuyenKhoa.Name</option>
                                                    }
                                                </select>
                                            </div>

                                            <!-- Chọn ngày thăm khám -->
                                            <div class="form-group">
                                                <label for="Appointment_Date">Ngày thăm khám:</label>
                                                <input type="date" id="Appointment_Date" name="Appointment_Date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-danger" data-dismiss="modal">Tắt</button>
                                            <button type="submit" class="btn btn-primary">Đăng ký</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên bệnh nhân</th>
                                        <th>Loại dịch vụ khám</th>
                                        <th>Tên bệnh viện</th>
                                        <th>Ngày đặt lịch thăm khám</th>
                                        <th>Trạng thái phiếu đăng ký</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModels.AppointmentViewModel>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@(item?.soThuTu.ToString() ?? "Không có dữ liệu")</td>
                                            <td>@(item?.name ?? "Không có dữ liệu")</td>
                                            <td>@(item.TenDichVu ?? "Không có dữ liệu")</td>
                                            <td>@(item?.tenBenhVien ?? "Không có dữ liệu")</td>
                                            <td>@(item?.Appointment_Date.ToString("dd/MM/yyyy") ?? "Không có dữ liệu")</td>
                                            <td>@(item?.trangThai?? "Không có dữ liệu")</td>
                                            <td>
                                                <a asp-action="ChiTietPhieuThamKham" asp-controller="DangKyThamKham" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem chi tiết</a>
                                                <form method="post" asp-action="huyDangKy" asp-controller="DangKyThamKham" asp-route-id="@item.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cuộc hẹn này không?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                                </form>
                                            </td>
                                           
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function() {
            $('#dataTables-example').dataTable();
        });
    </script>

    <script>    
        function loadChuyenKhoa() {
            var loaiDichVuId = document.getElementById("LoaiDichVuId").value;
            var chuyenKhoaDiv = document.getElementById("chuyenKhoaDiv");
            if (loaiDichVuId == "4"  ) {
                chuyenKhoaDiv.style.display = "block";
            } else {
                chuyenKhoaDiv.style.display = "none";
            }
        }
    </script>
}
