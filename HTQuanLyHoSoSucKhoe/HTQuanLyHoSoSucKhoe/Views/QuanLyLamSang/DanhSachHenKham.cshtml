@model List<HTQuanLyHoSoSucKhoe.ViewModel.DanhSachHenKhamViewModel>
@{
    Layout = "~/Views/Shared/_LamSangLayout.cshtml";
}
<div id="page-wrapper">
    <div class="header mt-5">
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Danh sách hẹn khám</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Advanced Tables -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng danh sách hẹn khám:
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT khám</th>
                                        <th>Số CCCD</th>
                                        <th>Họ và tên bệnh nhân</th>
                                        <th>Thời gian tạo</th>
                                        <th>Trạng thái</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModel.DanhSachHenKhamViewModel>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@item.soThuTu</td>
                                            <td name="cccd">@(item?.cccd ?? "Không có dữ liệu")</td>
                                            <td>@(item?.tenBenhNhan ?? "Không có dữ liệu")</td>
                                            <td>@(item?.thoiGianTao.ToString() ?? "Không có dữ liệu")</td>
                                            <td>@(item?.trangThai ?? "Không có dữ liệu")</td>
                                            <td>
                                                @{
                                                    if(item.trangThai == "Chưa tạo hồ sơ")
                                                    {
                                                        <a asp-action="TaoHoSo" asp-controller="QuanLyLamSang" asp-route-id="@item.id" class="btn btn-info btn-sm">Tạo hồ sơ</a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-action="ChiTietHoSo" asp-controller="QuanLyLamSang" asp-route-id="@item.id" class="btn btn-info btn-sm">Xem hồ sơ</a>
                                                    }

                                                    <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#taoPhieuChiDinhModal_@item.id">
                                                        Tạo phiếu chỉ định
                                                    </button>
                                                    <!-- Modal -->
                                                    <div class="modal fade" id="taoPhieuChiDinhModal_@item.id" tabindex="-1" role="dialog" aria-labelledby="taoPhieuChiDinhModalLabel_@item.id" aria-hidden="true">
                                                        <div class="modal-dialog">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                                    <h4 class="modal-title" id="taoPhieuChiDinhModalLabel_@item.id">Chỉnh sửa trạng thái</h4>
                                                                </div>
                                                                <form asp-action="taoPhieuChiDinh" asp-controller="QuanLyLamSang" method="post">
                                                                    <input type="hidden" name="id" value="@item.id"/>
                                                                    <div class="form-group">
                                                                        <label for="chuyenKhoa">Chọn chuyên khoa cận lâm sàng:</label>
                                                                        <select id="chuyenKhoa" name="SelectedChuyenKhoaId" class="form-control" required>
                                                                            @foreach (var tenChuyenKhoa in ViewBag.ChuyenKhoaOptions as List<SelectListItem>)
                                                                            {
                                                                                <option value="@tenChuyenKhoa.Value">@tenChuyenKhoa.Text</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-danger" data-dismiss="modal">Tắt</button>
                                                                        <button type="submit" class="btn btn-primary">Tạo phiếu chỉ định</button>
                                                                    </div>

                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function () {
            $('#dataTables-example').dataTable();
        });
    </script>
}