@model List<HTQuanLyHoSoSucKhoe.ViewModels.PhieuChiDinhViewModels>

@{
	Layout = "~/Views/Shared/_LamSangLayout.cshtml";
}

<div id="page-wrapper">
    <div class="header mt-5">
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Danh sách phiếu chỉ định</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Advanced Tables -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng danh sách phiếu chỉ định:
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Chỉ định</th>
                                        <th>Thời gian tạo</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModels.PhieuChiDinhViewModels>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@item.Id</td>
                                            <td>@(item?.LoaiChiDinh ?? "Không có dữ liệu")</td>
                                            <td>@(item?.Created_At.ToString() ?? "Không có dữ liệu")</td>
                                            <td>
                                                <a asp-action="" asp-controller="QuanLyCanLamSang" class="btn btn-info btn-sm">Xem chi tiết</a>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function() {
            $('#dataTables-example').dataTable();
        });
    </script>
}