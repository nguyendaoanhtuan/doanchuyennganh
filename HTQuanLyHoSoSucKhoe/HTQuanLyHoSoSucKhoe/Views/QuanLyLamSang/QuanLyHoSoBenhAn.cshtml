@model List<HTQuanLyHoSoSucKhoe.ViewModel.QuanLyBenhNhanViewModel>
@{
    Layout = "~/Views/Shared/_LamSangLayout.cshtml";
}
<div id="page-wrapper">
    <div class="header mt-5">
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Quản lý hồ sơ bệnh án</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Advanced Tables -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng danh sách bệnh nhân:
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Căn cước công dân</th>
                                        <th>Họ và tên</th>
                                        <th>Số điện thoại</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModel.QuanLyBenhNhanViewModel>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@index</td>
                                            <td>@(item?.hoTen ?? "Không có dữ liệu")</td>
                                            <td>@(item?.cccd ?? "Không có dữ liệu")</td>
                                            <td>@(item?.sdt ?? "Không có dữ liệu")</td>
                                            <td>
                                        <a asp-action="ChiTietBenhAn" asp-controller="QuanLyLamSang" asp-route-id="@item.id" class="btn btn-info btn-sm">Xem chi tiết</a>
                                        
                                        </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function () {
            $('#dataTables-example').dataTable();
        });
    </script>
}