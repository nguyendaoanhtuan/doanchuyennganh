@model HTQuanLyHoSoSucKhoe.ViewModels.AppointmentViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div id="page-wrapper">
    <div class="header">
        <h1 class="page-header">Cài đặt tài khoản</h1>
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Cài đặt tài khoản</li>
        </ol>
    </div>

    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">Bảng thông chi tiết phiếu đăng ký</div>
                    <div class="panel-body">
                        <div class="row">
                            <!-- Khu vực hiển thị bảng thông tin -->
                            <div class="col-md-6">
                                <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["SuccessMessage"]
                                    </div>
                                }
                                else if (TempData["ErrorMessage"] != null)
                                {
                                    <div class="alert alert-danger">
                                        @TempData["ErrorMessage"]
                                    </div>
                                }
                                <table class="detail-table">
                                    <tr>
                                        <th>Số thứ tự:</th>
                                        <td><input class="form-control" type="text" value="@Model.soThuTu" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Tên bệnh nhân:</th>
                                        <td><input class="form-control" type="text" value="@Model.name" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Số điện thoại:</th>
                                        <td><input class="form-control" type="text" value="@Model.phone_Number" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Căn cước công dân:</th>
                                        <td><input class="form-control" type="text" value="@Model.cccd" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Email:</th>
                                        <td><input class="form-control" type="text" value="@Model.email" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Tên dịch vụ:</th>
                                        <td><input class="form-control" type="text" value="@Model.TenDichVu" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Tên chuyên khoa cần khám:</th>
                                        <td><input class="form-control" type="text" value="@Model.tenChuyenKhoa" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Trạng thái phiếu đăng ký:</th>
                                        <td><input class="form-control" type="text" value="@Model.trangThai" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Ngày đăng ký:</th>
                                        <td><input class="form-control" type="text" value="@Model.Appointment_Date.ToString("dd/MM/yyyy")" readonly></td>
                                    </tr>
                                </table>
                                <div class="btn-container-form">
                                    <button class="btn btn-primary" data-toggle="modal" data-target="#editInfoModal_@Model.Id"><i class="fa fa-edit"></i> Chỉnh sửa</button>
                                </div>
                                <!-- Modal chỉnh sửa thông tin -->
                                <div class="modal fade" id="editInfoModal_@Model.Id" tabindex="-1" role="dialog" aria-labelledby="editInfoModalLabel_@Model.Id" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <form asp-action="chinhSuaThongTin" asp-controller="QuanLyDangKyThamKham" method="post">
                                            <div class="modal-content">
                                                <input type="hidden" name="appointmentId" value="@Model.Id" />
                                                <div class="modal-header">
                                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    <h4 class="modal-title" id="editInfoModalLabel_@Model.Id">Chỉnh sửa thông tin</h4>
                                                </div>
                                                <div class="modal-body">
                                                    <table class="detail-table">
                                                        <tr>
                                                            <th>Loại dịch vụ thăm khám:</th>
                                                            <td>
                                                                <div class="form-group">
                                                                    <select id="LoaiDichVuId" name="LoaiDichVuId" class="form-control" onchange="loadChuyenKhoa()" required>
                                                                        @foreach (var dichVu in ViewBag.LoaiDichVuList ?? new List<LoaiDichVuKham>())
                                                                        {
                                                                            <option value="@dichVu.Id">@dichVu.TenDichVu</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Chọn chuyên khoa cần khám:</th>
                                                            <td>
                                                                <!-- Chuyên khoa (Sẽ chỉ xuất hiện khi chọn "Khám chuyên khoa") -->
                                                                <div class="form-group" id="chuyenKhoaDiv" style="display:none;">
                                                                    <select id="ChuyenKhoaId" name="ChuyenKhoaId" class="form-control">
                                                                        <option value="">Chọn chuyên khoa</option>
                                                                        @foreach (var chuyenKhoa in ViewBag.ChuyenKhoaList ?? new List<ChuyenKhoa>())
                                                                        {
                                                                            <option value="@chuyenKhoa.Id">@chuyenKhoa.Name</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Ngày đăng ký mới:</th>
                                                            <td> <input type="date" id="Appointment_Date" name="Appointment_Date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required /></td>
                                                        </tr>       
                                                    </table>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-danger" data-dismiss="modal">Thoát</button>
                                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadChuyenKhoa() {
            var loaiDichVuId = document.getElementById("LoaiDichVuId").value;
            var chuyenKhoaDiv = document.getElementById("chuyenKhoaDiv");
            if (loaiDichVuId == "4") {
                chuyenKhoaDiv.style.display = "block";
            } else {
                chuyenKhoaDiv.style.display = "none";
            }
        }
    </script>
}