@model List<HTQuanLyHoSoSucKhoe.ViewModels.AppointmentViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div id="page-wrapper">
    <div class="header">
        <h1 class="page-header">
            Quản lý lịch sử thăm khám
        </h1>
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="DangKyThamKham">Trang chủ</a></li>
            <li class="active">Thông tin lịch sử thăm khám</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Hiển thị bảng lịch sử thăm khám -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng thông tin lịch sử thăm khám:
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên bệnh nhân</th>
                                        <th>Loại dịch vụ khám</th>
                                        <th>Ngày đặt lịch thăm khám</th>
                                        <th>Trạng thái phiếu đăng ký</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModels.AppointmentViewModel>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@(item?.soThuTu.ToString() ?? "Không có dữ liệu")</td>
                                            <td>@(item?.name ?? "Không có dữ liệu")</td>
                                            <td>@(item.TenDichVu ?? "Không có dữ liệu")</td>
                                            <td>@(item?.Appointment_Date.ToString("dd/MM/yyyy") ?? "Không có dữ liệu")</td>
                                            <td>@(item?.trangThai ?? "Không có dữ liệu")</td>
                                            <td>
                                                <a asp-action="ChiTietPhieuDangKyThamKham" asp-controller="QuanLyDangKyThamKham" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem chi tiết</a>

                                                <form method="post" asp-action="xoaDangKy" asp-controller="QuanLyDangKyThamKham" asp-route-id="@item.Id" onsubmit="return confirm('Bạn có chắc chắn muốn xóa cuộc hẹn này không?');">
                                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                                </form>

                                                <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#chinhSuaTrangThaiModal_@item.Id">
                                                    Chỉnh sửa trạng thái
                                                </button>
                                                <!-- Modal -->
                                                <div class="modal fade" id="chinhSuaTrangThaiModal_@item.Id" tabindex="-1" role="dialog" aria-labelledby="chinhSuaTrangThaiModalLabel_@item.Id" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                                <h4 class="modal-title" id="chinhSuaTrangThaiModalLabel_@item.Id">Chỉnh sửa trạng thái</h4>
                                                            </div>
                                                            <form asp-action="chinhSuaTrangThai" asp-controller="QuanLyDangKyThamKham" method="post">
                                                                <input type="hidden" name="appointmentId" value="@item.Id" />
                                                                <div class="form-group">
                                                                    <label for="trangThai">Chọn trạng thái mới:</label>
                                                                    <select id="trangThai" name="trangThai" class="form-control" required>
                                                                        <option value="Không có mặt">Không có mặt</option>
                                                                        <option value="Đã thăm khám">Đã thăm khám</option>
                                                                    </select>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-danger" data-dismiss="modal">Tắt</button>
                                                                    <button type="submit" class="btn btn-primary">Lưu chỉnh sửa</button>
                                                                </div>

                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function() {
            $('#dataTables-example').dataTable();
        });
    </script>

    
}
