@model List<HTQuanLyHoSoSucKhoe.ViewModels.PhieuChiDinhViewModels>

@{
    Layout = "~/Views/Shared/_CanLamSangLayout.cshtml";
}

<div id="page-wrapper">
    <div class="header mt-5">
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Danh sách phiếu chỉ định</li>
        </ol>
    </div>
    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <!-- Advanced Tables -->
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Bảng danh sách phiếu chỉ định:
                    </div>
                    <div class="panel-body">
                        <!-- Hiển thị thông báo thành công hoặc lỗi từ TempData -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        else if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Chỉ định</th>
                                        <th>Thời gian tạo</th>
                                        <th>hẹn id</th>
                                        <th>Chức năng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int index = 1;
                                    }
                                    @foreach (var item in Model ?? new List<HTQuanLyHoSoSucKhoe.ViewModels.PhieuChiDinhViewModels>())
                                    {
                                        <tr class="odd gradeX">
                                            <td>@item.Id</td>
                                            <td>@(item?.LoaiChiDinh ?? "Không có dữ liệu")</td>
                                            <td>@(item?.Created_At.ToString() ?? "Không có dữ liệu")</td>
                                            <td>@item.appointmentId</td>
                                            <td>
                                                <a asp-action="ChiTietPhieuChiDinh" asp-controller="QuanLyCanLamSang" asp-route-id="@item.Id" class="btn btn-info btn-sm">Xem chi tiết</a>
                                                <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#taoPhieuKetQuaModal_@item.phieuKetQuaId">
                                                    Tạo phiếu kết quả
                                                </button>
                                                <!-- Modal -->
                                                <div class="modal fade" id="taoPhieuKetQuaModal_@item.phieuKetQuaId" tabindex="-1" role="dialog" aria-labelledby="taoPhieuKetQuaModalLabel_@item.phieuKetQuaId" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                                <h4 class="modal-title" id="taoPhieuKetQuaModalLabel_@item.phieuKetQuaId">Tạo phiếu kết quả</h4>
                                                            </div>
                                                            <form asp-action="taoPhieuKetQua" asp-controller="QuanLyCanLamSang" method="post" enctype="multipart/form-data">
                                                                <input type="hidden" name="Id" value="@item.Id"/>
                                                                <input type="hidden" name="appointmentId" value="@item.appointmentId" />
                                                                <input type="hidden" name="hoSoBenhAnId" value="@item.hoSoBenhAnId" />
                                                                <input type="hidden" name="chuyenKhoaId" value="@item.chuyenKhoaId" />
                                                                <input type="hidden" name="bacSiId" value="@item.bacSiId" />
                                                                 <table class="detail-table">
                                                                    <div class="form-group">
                                                                        <label for="chuyenKhoa">Tải file thứ nhất lên:</label>
                                                                        <input type="file" name="file1" class="form-control mt-3" required>
                                                                    </div>
                                                                 </table>
                                                                <table class="detail-table">
                                                                    <label for="bacSi">Chọn bác sĩ:</label>
                                                                    <select id="bacSi" name="SelectedBacSiId" class="form-control" required>
                                                                        @foreach (var bacSi in ViewBag.BacSiList as List<BacSi>)
                                                                        {
                                                                            <option value="@bacSi.Id">@bacSi.hoTen</option>
                                                                        }
                                                                    </select>
                                                                </table>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-danger" data-dismiss="modal">Tắt</button>
                                                                    <button type="submit" class="btn btn-primary">Tạo phiếu kết quả</button>
                                                                </div>

                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/dataTables/jquery.dataTables.js"></script>
    <script src="~/assets/js/dataTables/dataTables.bootstrap.js"></script>
    <script>
        $(document).ready(function() {
            $('#dataTables-example').dataTable();
        });
    </script>
}