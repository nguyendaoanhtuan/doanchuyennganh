@model HTQuanLyHoSoSucKhoe.ViewModels.PhieuKetQuaViewModel

@{
    Layout = "~/Views/Shared/_CanLamSangLayout.cshtml";
}


<div id="page-wrapper">
    <div class="header">
        <h1 class="page-header">Cài đặt tài khoản</h1>
        <ol class="breadcrumb">
            <li><a asp-action="Index" asp-controller="QuanLyBenhVien">Trang chủ</a></li>
            <li class="active">Cài đặt tài khoản</li>
        </ol>
    </div>

    <div id="page-inner">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">Bảng thông tin kết quả khám</div>
                    <div class="panel-body">
                        <div class="row">
                            <!-- Khu vực hiển thị bảng thông tin -->
                            <div class="col-md-6">
                                <table class="detail-table">
                                    <tr>
                                        <th>Id:</th>
                                        <td><input class="form-control" type="text" value="@Model.Id" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Tên bệnh nhân:</th>
                                        <td><input class="form-control" type="text" value="@Model.tenBenhNhan" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Số điện thoại:</th>
                                        <td><input class="form-control" type="text" value="@Model.PhoneNumber" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Cccd:</th>
                                        <td><input class="form-control" type="text" value="@Model.Cccd" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Tên bác sĩ tạo kệt quả:</th>
                                        <td><input class="form-control" type="text" value="@Model.tenBacSi" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Chuyên khoa tạo phiếu:</th>
                                        <td><input class="form-control" type="text" value="@Model.TenChuyenKhoaCanLamSang" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Chuyên khoa yêu cầu:</th>
                                        <td><input class="form-control" type="text" value="@Model.TenChuyenKhoaLamSang" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Ngày hẹn khám:</th>
                                        <td><input class="form-control" type="text" value="@Model.NgayDangKy" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>Ngày tạo chỉ định:</th>
                                        <td><input class="form-control" type="text" value="@Model.ThoiGianTaoPhieuChiDinh" readonly></td>
                                    </tr>
                                    <tr>
                                        <th>File kết quả:</th>
                                        <td>
                                            @if (!string.IsNullOrEmpty(Model.File1))
                                            {
                                                <a class="form-control" href="@Model.File1" target="_blank">Xem File</a>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Ngày tạo kết quả:</th>
                                        <td><input class="form-control" type="text" value="@Model.Created_At" readonly></td>
                                    </tr>

                                </table>
                                <div class="btn-container-form">
                                    <button class="btn btn-primary" data-toggle="modal" data-target="#editInfoModal_@Model.Id"><i class="fa fa-edit"></i> Chỉnh sửa</button>
                                </div>
                                <!-- Modal chỉnh sửa thông tin -->
                                <div class="modal fade" id="editInfoModal_@Model.Id" tabindex="-1" role="dialog" aria-labelledby="editInfoModalLabel_@Model.Id" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <form asp-action="ChinhSuaPhieuKetQua" asp-controller="QuanLyCanLamSang" method="post" enctype="multipart/form-data">
                                            <div class="modal-content">
                                                <input type="hidden" name="phieuKetQuaId" value="@Model.Id">
                                                <div class="modal-header">
                                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                    <h4 class="modal-title" id="editInfoModalLabel_@Model.Id">Chỉnh sửa thông tin</h4>
                                                </div>
                                                <div class="modal-body">
                                                    <table class="detail-table">
                                                        <label for="chuyenKhoa">Tải file mới lên:</label>
                                                        <input type="file" name="file1" class="form-control mt-3" required>
                                                    </table>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-danger" data-dismiss="modal">Thoát</button>
                                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>